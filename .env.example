# Copy this file to .env on the Pi and fill in real values. .env is
# gitignored — never commit it.

POSTGRES_PASSWORD=change-me

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# FDB-ADMIN is the one bootstrap account the application creates
# itself on first startup. Only its password is configurable here —
# the username is fixed to "FDB-ADMIN" in code. Every other account
# is created afterwards by that admin, through the dashboard itself.
ADMIN_PASSWORD=change-me
