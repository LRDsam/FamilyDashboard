# Copy this file to .env on the Pi and fill in real values. .env is
# gitignored — never commit it.

POSTGRES_PASSWORD=change-me

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# One family account per SEED_USER_<n>_... group (index starting at 0).
# Add SEED_USER_1_..., SEED_USER_2_... etc. for more accounts, and add
# the matching block to docker-compose.yml's backend.environment.
SEED_USER_0_USERNAME=
SEED_USER_0_PASSWORD=
SEED_USER_0_FIRSTNAME=
SEED_USER_0_LASTNAME=
SEED_USER_0_ISADMIN=false
